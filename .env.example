# ---------------------------------------------------------------------------
# Copie para .env e preencha os valores. O .env real nunca é versionado.
# ---------------------------------------------------------------------------

# Provedor de IA (endpoint compatível com OpenAI).
# Chave gratuita do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: troque de provedor sem tocar no código.
# Ver docs/gemini-provider.md para a tabela de provedores compatíveis.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=

# Voz neural (síntese no servidor). Timbres masculinos: Charon (informativo,
# padrão), Orus (firme), Gacrux (maduro), Algieba (suave), Iapetus, Puck.
# Se a síntese falhar, o navegador cai na voz do sistema automaticamente.
TTS_VOICE=Charon
# TTS_MODEL=gemini-3.1-flash-tts-preview
# TTS_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Senha única de acesso ao Jarvis.
APP_PASSWORD=

# Segredo que assina o cookie de sessão. Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Nome exibido para o dono da instalação.
OWNER_NAME=Operador

# Arquivo SQLite (criado sozinho no primeiro boot).
DATABASE_URL=./data/jarvis.db

# Porta do servidor.
PORT=3000

# GitHub — o que o seu token alcança, o Jarvis alcança (repositórios, issues,
# pull requests, conteúdo, busca de código). Escrever em repositório pede
# confirmação por clique; ler passa direto.
# Crie em https://github.com/settings/tokens com os escopos: repo, read:org, read:user
# GITHUB_TOKEN=
